      "sides": [
        {
          "side": "right",
          "main_language": "lzh",
          "columns": [
            {
              "text": "英界長發棧今"
            },
            {
              "text": "春寓有某氏婦口"
            },
            {
              "text": "操山左音前曾産"
            },
            {
              "text": "一孩頗具異相人"
            },
            {
              "text": "初不之知也日前聞"
            },
            {
              "text": "美界同仁醫院之西"
            },
            {
              "text": "醫生擅扁盧術能視"
            },
            {
              "text": "奇疾遂乘肩輿抱孩"
            }
          ],
          "extras": [
            {
              "type": "article-title",
              "location": "篇題（橫書右起）",
              "text": "頭上生頭",
              "figure_zone": "f02-r-feature-1",
              "language": "lzh"
            },
            {
              "type": "artist-signature",
              "location": "圖內右下畫款",
              "text": "符節",
              "figure_zone": "f02-r-feature-2",
              "language": "lzh"
            },
            {
              "type": "artist-seal",
              "location": "畫款下方印",
              "text": "",
              "figure_zone": "f02-r-feature-3"
            },
            {
              "type": "inscription",
              "location": "櫃上藥瓶小字未辨",
              "text": "",
              "figure_zone": "f02-r-feature-4"
            }
          ]
        },
        {
          "side": "left",
          "main_language": "lzh",
          "columns": [
            {
              "text": "往診先由女醫驗視見"
            },
            {
              "text": "該孩五官無異惟首上"
            },
            {
              "text": "有首二首層疊若葫蘆"
            },
            {
              "text": "祇上一首雖不能吃乳而"
            },
            {
              "text": "耳目口鼻無異常兒爰告"
            },
            {
              "text": "知院主文醫士邀集在滬"
            },
            {
              "text": "之中西諸名醫到院商議"
            },
            {
              "text": "婦請將孩之上首用刀割去"
            },
            {
              "text": "諸醫以孩生甫彌月氣力過"
            },
            {
              "text": "弱一經奏刀恐不免有性命"
            },
            {
              "text": "之虞請俟稍長始可設法割"
            },
            {
              "text": "治婦無奈怏〻而回按前者"
            },
            {
              "text": "滬上來一兩頭孩係前後背"
            },
            {
              "text": "生兩面皆能飲食一時傳為"
            },
            {
              "text": "異事今乃頭上加頭斯真可"
            },
            {
              "text": "謂出人頭地矣"
            }
          ],
