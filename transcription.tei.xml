  <text>
    <body>
      <div type="codex">
        <pb n="1" facs="#f01" />
        <div n="1" type="scan" subtype="complete-illustrated-report">
          <div type="page-face" n="left" xml:lang="lzh">
            <ab type="column" n="1" xml:id="f01-l-c01">
              <seg type="diplomatic-text">讀得湯頭歌訣便躋時醫胡亂開方草菅人命死也</seg>
            </ab>
            <ab type="column" n="2" xml:id="f01-l-c02">
              <seg type="diplomatic-text">而委之數律無抵偶然徼幸病者之稱道也人情也</seg>
            </ab>
            <ab type="column" n="3" xml:id="f01-l-c03">
              <seg type="diplomatic-text">而醫者亦居之不疑以為非我莫汝生也及叩其所以</seg>
            </ab>
            <ab type="column" n="4" xml:id="f01-l-c04">
              <seg type="diplomatic-text">病所以生之理而膚淺支離不待其詞之畢而已</seg>
            </ab>
            <ab type="column" n="5" xml:id="f01-l-c05">
              <seg type="diplomatic-text">掩耳之不及矣迺者西國女醫名麗盈始乃逗者</seg>
            </ab>
            <ab type="column" n="6" xml:id="f01-l-c06">
              <seg type="diplomatic-text">婦科其專門也而旁通外科有徽婦生一瘤其</seg>
            </ab>
            <ab type="column" n="7" xml:id="f01-l-c07">
              <seg type="diplomatic-text">大無匹就醫於虹口之同仁醫院女醫按之曰是可</seg>
            </ab>
            <ab type="column" n="8" xml:id="f01-l-c08">
              <seg type="diplomatic-text">治出利刀而□之下敷以藥匝月而愈權之重</seg>
            </ab>
            <ab type="column" n="9" xml:id="f01-l-c09">
              <seg type="diplomatic-text">可人身四分之一夫何如乎是症不遇是</seg>
            </ab>
            <ab type="column" n="10" xml:id="f01-l-c10">
              <seg type="diplomatic-text">醫萬難望病之郤是醫不遇是症誰</seg>
            </ab>
            <ab type="column" n="11" xml:id="f01-l-c11">
              <seg type="diplomatic-text">為知術之神之兩人者殆有天緣乎華</seg>
            </ab>
            <ab type="column" n="12" xml:id="f01-l-c12">
              <seg type="diplomatic-text">醫聞之將不免舌撟不下首俯不禁矣</seg>
            </ab>
            <ab type="page-feature" subtype="article-title" facs="#f01-l-feature-1">
              <label>篇題（橫書右起）</label>
              <seg type="diplomatic-text" rend="unknown" xml:lang="lzh">著手成春</seg>
            </ab>
            <ab type="page-feature" subtype="form-mark" facs="#f01-l-feature-2">
              <label>原刊圖號</label>
              <seg type="diplomatic-text" rend="unknown" xml:lang="lzh">八十一</seg>
            </ab>
            <ab type="page-feature" subtype="form-mark" facs="#f01-l-feature-3">
              <label>原刊期碼</label>
              <seg type="diplomatic-text" rend="unknown" xml:lang="lzh">乙十一</seg>
            </ab>
            <ab type="page-feature" subtype="artist-signature" facs="#f01-l-feature-4">
              <label>圖內左下畫款</label>
              <seg type="diplomatic-text" rend="unknown" xml:lang="lzh">友如吳獻</seg>
            </ab>
            <ab type="page-feature" subtype="artist-seal" facs="#f01-l-feature-5">
              <label>畫款下方印</label>
              <seg type="diplomatic-text" rend="unknown" />
            </ab>
            <ab type="page-feature" subtype="printer-seal" facs="#f01-l-feature-6">
              <label>圖說末左下方印</label>
              <seg type="diplomatic-text" rend="unknown" />
            </ab>
            <ab type="page-feature" subtype="inscription" facs="#f01-l-feature-7">
              <label>櫃上藥瓶小字未辨</label>
              <seg type="diplomatic-text" rend="unknown" />
            </ab>
          </div>
          <div type="editorial-observations">
            <ab type="layout">只錄此幅左面的完整圖說及圖內題署；右面與本篇分幅，另題〈誤認桃源〉。</ab>
            <ab type="transcription-issue" n="left:5">
              <quote>麗盈始乃逗</quote>
              <seg type="candidate">逗</seg>
              <seg type="candidate">迴</seg>
              <seg type="candidate">迺</seg>
              <note type="editorial">西醫音譯末字的辶清楚，內部框線連筆。</note>
            </ab>
            <ab type="transcription-issue" n="left:8">
              <quote>利刀而□之</quote>
              <seg type="candidate">刢</seg>
              <seg type="candidate">刓</seg>
              <seg type="candidate">剖</seg>
              <note type="editorial">該動詞右刂可見，左部手寫連線不足確讀。</note>
            </ab>
            <ab type="transcription-issue" n="left:12">
              <quote>舌撟不下</quote>
              <seg type="candidate">撟</seg>
              <seg type="candidate">橋</seg>
              <note type="editorial">舌次字從手旁。下右另有小點，與文字關係未明。</note>
            </ab>
          </div>
        </div>
        <pb n="2" facs="#f02" />
        <div n="2" type="scan" subtype="complete-illustrated-report">
          <div type="page-face" n="right" xml:lang="lzh">
            <ab type="column" n="1" xml:id="f02-r-c01">
              <seg type="diplomatic-text">英界長發棧今</seg>
            </ab>
            <ab type="column" n="2" xml:id="f02-r-c02">
              <seg type="diplomatic-text">春寓有某氏婦口</seg>
            </ab>
            <ab type="column" n="3" xml:id="f02-r-c03">
              <seg type="diplomatic-text">操山左音前曾産</seg>
            </ab>
            <ab type="column" n="4" xml:id="f02-r-c04">
              <seg type="diplomatic-text">一孩頗具異相人</seg>
            </ab>
            <ab type="column" n="5" xml:id="f02-r-c05">
              <seg type="diplomatic-text">初不之知也日前聞</seg>
            </ab>
            <ab type="column" n="6" xml:id="f02-r-c06">
              <seg type="diplomatic-text">美界同仁醫院之西</seg>
            </ab>
            <ab type="column" n="7" xml:id="f02-r-c07">
              <seg type="diplomatic-text">醫生擅扁盧術能視</seg>
            </ab>
            <ab type="column" n="8" xml:id="f02-r-c08">
              <seg type="diplomatic-text">奇疾遂乘肩輿抱孩</seg>
            </ab>
            <ab type="page-feature" subtype="article-title" facs="#f02-r-feature-1">
              <label>篇題（橫書右起）</label>
              <seg type="diplomatic-text" rend="unknown" xml:lang="lzh">頭上生頭</seg>
            </ab>
            <ab type="page-feature" subtype="artist-signature" facs="#f02-r-feature-2">
              <label>圖內右下畫款</label>
              <seg type="diplomatic-text" rend="unknown" xml:lang="lzh">符節</seg>
            </ab>
            <ab type="page-feature" subtype="artist-seal" facs="#f02-r-feature-3">
              <label>畫款下方印</label>
              <seg type="diplomatic-text" rend="unknown" />
            </ab>
            <ab type="page-feature" subtype="inscription" facs="#f02-r-feature-4">
              <label>櫃上藥瓶小字未辨</label>
              <seg type="diplomatic-text" rend="unknown" />
            </ab>
          </div>
          <div type="page-face" n="left" xml:lang="lzh">
            <ab type="column" n="1" xml:id="f02-l-c01">
              <seg type="diplomatic-text">往診先由女醫驗視見</seg>
            </ab>
            <ab type="column" n="2" xml:id="f02-l-c02">
              <seg type="diplomatic-text">該孩五官無異惟首上</seg>
            </ab>
            <ab type="column" n="3" xml:id="f02-l-c03">
              <seg type="diplomatic-text">有首二首層疊若葫蘆</seg>
            </ab>
            <ab type="column" n="4" xml:id="f02-l-c04">
              <seg type="diplomatic-text">祇上一首雖不能吃乳而</seg>
            </ab>
            <ab type="column" n="5" xml:id="f02-l-c05">
              <seg type="diplomatic-text">耳目口鼻無異常兒爰告</seg>
            </ab>
            <ab type="column" n="6" xml:id="f02-l-c06">
              <seg type="diplomatic-text">知院主文醫士邀集在滬</seg>
            </ab>
            <ab type="column" n="7" xml:id="f02-l-c07">
              <seg type="diplomatic-text">之中西諸名醫到院商議</seg>
            </ab>
            <ab type="column" n="8" xml:id="f02-l-c08">
              <seg type="diplomatic-text">婦請將孩之上首用刀割去</seg>
            </ab>
            <ab type="column" n="9" xml:id="f02-l-c09">
              <seg type="diplomatic-text">諸醫以孩生甫彌月氣力過</seg>
            </ab>
            <ab type="column" n="10" xml:id="f02-l-c10">
              <seg type="diplomatic-text">弱一經奏刀恐不免有性命</seg>
            </ab>
            <ab type="column" n="11" xml:id="f02-l-c11">
              <seg type="diplomatic-text">之虞請俟稍長始可設法割</seg>
            </ab>
            <ab type="column" n="12" xml:id="f02-l-c12">
              <seg type="diplomatic-text">治婦無奈怏〻而回按前者</seg>
            </ab>
            <ab type="column" n="13" xml:id="f02-l-c13">
              <seg type="diplomatic-text">滬上來一兩頭孩係前後背</seg>
            </ab>
            <ab type="column" n="14" xml:id="f02-l-c14">
              <seg type="diplomatic-text">生兩面皆能飲食一時傳為</seg>
            </ab>
            <ab type="column" n="15" xml:id="f02-l-c15">
              <seg type="diplomatic-text">異事今乃頭上加頭斯真可</seg>
            </ab>
            <ab type="column" n="16" xml:id="f02-l-c16">
              <seg type="diplomatic-text">謂出人頭地矣</seg>
            </ab>
            <ab type="page-feature" subtype="form-mark" facs="#f02-l-feature-1">
              <label>原刊圖號</label>
              <seg type="diplomatic-text" rend="unknown" xml:lang="lzh">三十二</seg>
            </ab>
            <ab type="page-feature" subtype="form-mark" facs="#f02-l-feature-2">
              <label>原刊期碼</label>
              <seg type="diplomatic-text" rend="unknown" xml:lang="lzh">書四</seg>
            </ab>
            <ab type="page-feature" subtype="printer-seal" facs="#f02-l-feature-3">
              <label>圖說末左側上圓印</label>
              <seg type="diplomatic-text" rend="unknown" />
            </ab>
            <ab type="page-feature" subtype="printer-seal" facs="#f02-l-feature-4">
              <label>圖說末左側下圓印</label>
              <seg type="diplomatic-text" rend="unknown" />
            </ab>
            <ab type="page-feature" subtype="inscription" facs="#f02-l-feature-5">
              <label>櫃上藥瓶小字未辨</label>
              <seg type="diplomatic-text" rend="unknown" />
            </ab>
          </div>
          <div type="editorial-observations">
            <ab type="layout">先讀右面的橫題和八欄，再讀左面的十六欄。右下圖款及左方刊記另錄。</ab>
            <ab type="transcription-issue" n="left:4">
              <quote>祇上一首</quote>
              <seg type="candidate">祇</seg>
              <seg type="candidate">祗</seg>
              <note type="editorial">示旁可辨，右底小筆有連痕。</note>
            </ab>
          </div>
        </div>
      </div>
    </body>
  </text>
